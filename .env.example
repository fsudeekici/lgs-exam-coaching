# Production settings for docker-compose.prod.yml.
# Copy to .env and fill in every value. Never commit .env.

# --- Database ---
POSTGRES_USER=lgs
# Letters and digits only (it is placed inside a connection URL).
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=lgs_coaching

# --- Backend ---
# At least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=
# How long a login lasts, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# How long a login lasts when "Beni hatırla" is ticked, in days.
REMEMBER_ME_DAYS=30

# First admin account, created on first start. At least 8 characters.
# Change the password in the app after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# A login is blocked after this many wrong passwords for one email within the window.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Web ---
# Port nginx listens on, on the host.
HTTP_PORT=80

# --- Backups (scripts/backup.sh) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
